# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/chitatel

# JWT
JWT_SECRET=your-jwt-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# Apple Auth
APPLE_CLIENT_ID=app.chitatel.ios
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# Google Auth — проект Google Cloud chitatel-490014 (номер 29430814146).
# Два клиента OAuth, оба принимаются как получатель idToken:
#   GOOGLE_CLIENT_ID        — клиент типа iOS (зашит в приложении);
#   GOOGLE_SERVER_CLIENT_ID — клиент типа Web, на Android идёт в
#     GoogleSignIn(serverClientId:) и становится `aud` токена (задача B1).
# Идентификаторы клиентов не секретны, client secret здесь не нужен.
GOOGLE_CLIENT_ID=
GOOGLE_SERVER_CLIENT_ID=29430814146-76mb9hqgkifg4i80in19d8ug29f7oe3t.apps.googleusercontent.com

# OpenAI
OPENAI_API_KEY=

# Apple IAP
APPLE_ISSUER_ID=
APPLE_KEY_ID_IAP=
APPLE_IAP_PRIVATE_KEY_PATH=
APPLE_BUNDLE_ID=app.chitatel.ios

# Push (APNs)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_KEY_PATH=

# Audio (задача 2.3 — signed URLs)
# AUDIO_SECRET — HMAC-ключ для подписи временных аудио-URL. Генерация: openssl rand -hex 32
# Для разработки оставьте dev-значение. Для продакшена ОБЯЗАТЕЛЬНО сгенерировать новый.
AUDIO_SECRET=dev-audio-secret-CHANGE-IN-PROD-min-32-chars
# AUDIO_BASE_PATH — корневая папка с MP3-файлами на файловой системе сервера.
# В разработке: /Users/<user>/Chitatel_app/audio-storage (на твоём Mac)
# В продакшене: /var/audio/chitatel (на VPS)
AUDIO_BASE_PATH=/var/audio/chitatel
# AUDIO_URL_TTL_SECONDS — срок действия signed URL (стандарт: 3600 = 1 час)
AUDIO_URL_TTL_SECONDS=3600
# PUBLIC_BASE_URL — базовый URL сервера (для генерации полных signed URL).
# В разработке: http://localhost:3000
# В продакшене: https://api.chitatel.app
PUBLIC_BASE_URL=http://localhost:3000

# Admin
ADMIN_EMAIL=anna@chitatel.app

# --- Google Play (покупки Android, задачи E4/E5 ANDROID-PLAN) ---
# JSON-ключ сервисного аккаунта с доступом в Play Console. Файл ВНЕ репозитория.
GOOGLE_PLAY_KEY_PATH=
# applicationId приложения
GOOGLE_PLAY_PACKAGE=app.chitatel
# Секрет в адресе вебхука Pub/Sub: /api/webhooks/google?token=...
GOOGLE_RTDN_SECRET=
